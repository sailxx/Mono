<Application x:Class="WinOTP.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="SystemAccentColor">#4CC2FF</Color>
      <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/CascadiaCode.ttf#Cascadia Code</FontFamily>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#0F0F0F"/>
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#171717"/>
      <SolidColorBrush x:Key="BorderBrushSoft" Color="#262626"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDED"/>
      <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A8A"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
      <SolidColorBrush x:Key="AccentTextBrush" Color="#06121A"/>
      <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
      <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/></Style>
      <Style TargetType="TextBox"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="11,9"/></Style>
      <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,7"/></Style>
      <Style TargetType="PasswordBox"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="11,9"/></Style>
      <Style x:Key="DialogFooterButtonStyle" TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,8"/></Style>
      <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogFooterButtonStyle}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
      <Style TargetType="ContentDialog"><Setter Property="RequestedTheme" Value="Dark"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Background" Value="#121212"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="PrimaryButtonStyle" Value="{StaticResource DialogPrimaryButtonStyle}"/><Setter Property="CloseButtonStyle" Value="{StaticResource DialogFooterButtonStyle}"/><Setter Property="SecondaryButtonStyle" Value="{StaticResource DialogFooterButtonStyle}"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
