<Application x:Class="Mono.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
      <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Foreground" Value="#EAEAEA"/></Style>
      <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/></Style>
      <Style TargetType="TextBox"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#EEEEEE"/></Style>
      <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/></Style>
      <Style TargetType="PasswordBox"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="11"/></Style>
      <Style TargetType="ContentDialog"><Setter Property="RequestedTheme" Value="Dark"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
