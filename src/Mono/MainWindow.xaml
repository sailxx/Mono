<Window x:Class="Mono.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mono">
  <Grid RequestedTheme="Dark" Background="#000000" Margin="18" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="3"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="mono" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" FontSize="9" Foreground="#777777" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="CountText" Text="ЛОКАЛЬНОЕ ХРАНИЛИЩЕ" FontSize="9" Foreground="#707070"/></StackPanel>
      <Button x:Name="ShowCodesButton" Grid.Column="1" Content="Показать коды" Click="ShowCodes_Click" Background="#111111" Foreground="#D0D0D0" CornerRadius="7" Padding="10,8"/>
      <Button Grid.Column="2" Content="+ Добавить" Click="Add_Click" Background="#FFFFFF" Foreground="#080808" CornerRadius="7" Padding="11,8" FontWeight="SemiBold"/>
    </Grid>
    <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="> фильтр по сервису или аккаунту" Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" CornerRadius="7" Padding="11,9" TextChanged="Search_Changed"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7">
      <Button x:Name="ImportButton" Content="Импорт" Click="Import_Click" Background="#111111" Foreground="#D0D0D0" CornerRadius="7" Padding="10,7"/>
      <Button Content="Резервная копия" Click="Backup_Click" Background="#111111" Foreground="#D0D0D0" CornerRadius="7" Padding="10,7"/>
      <Button Content="Настройки" Click="Settings_Click" Background="#111111" Foreground="#D0D0D0" CornerRadius="7" Padding="10,7"/>
    </StackPanel>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"><StackPanel x:Name="AccountList" Spacing="8"/></ScrollViewer>
    <Grid Grid.Row="4"><TextBlock x:Name="ClockText" HorizontalAlignment="Right" Text="RFC 6238" FontSize="9" Foreground="#777777"/></Grid>
  </Grid>
</Window>
