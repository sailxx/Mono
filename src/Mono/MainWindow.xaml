<Window x:Class="Mono.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOTP">
  <Grid RequestedTheme="Dark" Background="#0B0B0B" Padding="16,14,16,12" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="3"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="WinOTP" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="CountText" Text="LOCAL VAULT" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
      <Button x:Name="ShowCodesButton" Grid.Column="1" Content="Hide codes" Click="ShowCodes_Click" Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="11,7"/>
      <Button Grid.Column="2" Content="+ Add" Click="Add_Click" Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0" Padding="12,7" FontWeight="SemiBold"/>
    </Grid>
    <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Search accounts" TextChanged="Search_Changed"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AccountList" Spacing="8"/></ScrollViewer>
    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="8,6">
      <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="ImportButton" Content="Import" Click="Import_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" Padding="10,6"/>
        <Button Grid.Column="1" Content="Backup" Click="Backup_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" Padding="10,6"/>
        <Button Grid.Column="2" Content="Settings" Click="Settings_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" Padding="10,6"/>
        <TextBlock Grid.Column="3" x:Name="ClockText" HorizontalAlignment="Right" VerticalAlignment="Center" Text="RFC 6238" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
