<Window x:Class="Mono.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mono">
  <Grid Background="#000000" Margin="34" RowSpacing="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="12" Background="#FFFFFF" VerticalAlignment="Center"><TextBlock Text="M" Foreground="#090909" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="MONO" FontSize="16" FontWeight="SemiBold" CharacterSpacing="110"/><TextBlock x:Name="CountText" Text="ЛОКАЛЬНОЕ ХРАНИЛИЩЕ" FontSize="10" Foreground="#696969" CharacterSpacing="95"/></StackPanel>
      <Button x:Name="ImportButton" Grid.Column="2" Content="Импорт" Click="Import_Click" Background="#111111" Foreground="#D0D0D0" CornerRadius="9" Padding="13,9"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <Button x:Name="ShowCodesButton" Content="Показать коды" Click="ShowCodes_Click" Background="#111111" Foreground="#D0D0D0" CornerRadius="9" Padding="13,9"/>
        <Button Content="⚙" Click="Settings_Click" Background="#111111" Foreground="#D0D0D0" CornerRadius="9" Padding="13,9"/>
        <Button Content="＋ Добавить" Click="Add_Click" Background="#FFFFFF" Foreground="#080808" CornerRadius="9" Padding="15,9" FontWeight="SemiBold"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" PlaceholderText="⌕   Поиск по сервисам и аккаунтам" Background="#0A0A0A" BorderThickness="0" CornerRadius="10" Padding="14,11" TextChanged="Search_Changed"/>
      <Button Grid.Column="1" Content="Резервная копия" Click="Backup_Click" Background="#111111" Foreground="#D0D0D0" CornerRadius="9" Padding="13,9"/>
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AccountList" Spacing="8"/></ScrollViewer>
    <Grid Grid.Row="3"><TextBlock Text="СЕКРЕТЫ ЗАЩИЩЕНЫ DPAPI · ЭТО УСТРОЙСТВО" FontSize="9" Foreground="#525252" CharacterSpacing="70"/><TextBlock x:Name="ClockText" HorizontalAlignment="Right" Text="RFC 6238 / RFC 4226" FontSize="10" Foreground="#585858" FontFamily="{StaticResource MonoFont}"/></Grid>
  </Grid>
</Window>
