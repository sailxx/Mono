<Window x:Class="Mono.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mono">
  <Grid RequestedTheme="Dark" Background="#080808" Margin="20" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="MONO" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" FontSize="10" Foreground="#8A8A8A" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="CountText" Text="ЛОКАЛЬНОЕ ХРАНИЛИЩЕ" FontSize="9" Foreground="#929292"/></StackPanel>
      <Button x:Name="ShowCodesButton" Grid.Column="1" Content="Скрыть коды" Click="ShowCodes_Click" Background="#151515" Foreground="#E0E0E0" CornerRadius="10" Padding="12,9"/>
      <Button Grid.Column="2" Content="+ Добавить" Click="Add_Click" Background="#F1F1F1" Foreground="#080808" CornerRadius="10" Padding="13,9" FontWeight="SemiBold"/>
    </Grid>
    <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Фильтр по сервису или аккаунту" Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="11" Padding="12,10" TextChanged="Search_Changed"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button x:Name="ImportButton" Content="Импорт" Click="Import_Click" Background="#151515" Foreground="#E0E0E0" CornerRadius="10" Padding="11,8"/>
      <Button Content="Резервная копия" Click="Backup_Click" Background="#151515" Foreground="#E0E0E0" CornerRadius="10" Padding="11,8"/>
      <Button Content="Настройки" Click="Settings_Click" Background="#151515" Foreground="#E0E0E0" CornerRadius="10" Padding="11,8"/>
    </StackPanel>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,1,0,0"><StackPanel x:Name="AccountList" Spacing="10"/></ScrollViewer>
    <Grid Grid.Row="4"><TextBlock x:Name="ClockText" HorizontalAlignment="Right" Text="RFC 6238" FontSize="9" Foreground="#929292"/></Grid>
  </Grid>
</Window>
